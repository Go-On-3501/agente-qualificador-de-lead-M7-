# Copie este arquivo para .streamlit/secrets.toml e preencha os valores.
# O secrets.toml NUNCA deve ser enviado ao repositório (já está no .gitignore).

ANTHROPIC_API_KEY = "sk-ant-COLOQUE_SUA_CHAVE_AQUI"

# Cole aqui o conteúdo completo do seu credentials.json (conta de serviço Google)
[gcp_service_account]
type = "service_account"
project_id = "SEU_PROJECT_ID"
private_key_id = "SEU_PRIVATE_KEY_ID"
private_key = "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
client_email = "sua-conta@seu-projeto.iam.gserviceaccount.com"
client_id = "SEU_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/sua-conta%40seu-projeto.iam.gserviceaccount.com"
